; Sequential write + read-back verify.
; DESTRUCTIVE — overwrites the raw block device.
; Catches data-path corruption: bit flips, silent write errors, FTL bugs.
; verify_mismatches > 0 after this job = hard FAIL (fio_verify_mismatch rule).
[global]
ioengine=io_uring
direct=1
thread=1
time_based=1
runtime=1200
group_reporting=1
verify=crc32c
verify_backlog=512
do_verify=1

[seq_write_verify]
rw=write
bs=1M
iodepth=8
numjobs=1
