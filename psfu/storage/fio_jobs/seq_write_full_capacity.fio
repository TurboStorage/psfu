; Sequential full-capacity write.
; DESTRUCTIVE — overwrites the raw block device end-to-end.
; Exhausts the SLC write cache and forces the FTL into steady-state TLC/QLC
; writes. Used before the verify pass to eliminate pSLC headroom.
; Does not verify — use seq_write_verify.fio for data-integrity checks.
[global]
ioengine=io_uring
direct=1
thread=1
time_based=1
runtime=600
group_reporting=1

[seq_write_full]
rw=write
bs=1M
iodepth=8
numjobs=1
